 #import "NSString_SKExtensions.h"
 #import "SKPreferenceController.h"
 
+// Option or Option-Shift on a key that types a character, not on a function key
+static inline BOOL SKIsOptionCharacterEvent(NSEvent *anEvent) {
+    if (([anEvent deviceIndependentModifierFlags] & (NSEventModifierFlagCommand | NSEventModifierFlagControl | NSEventModifierFlagOption | NSEventModifierFlagFunction)) != NSEventModifierFlagOption)
+        return NO;
+    NSString *characters = [anEvent charactersIgnoringModifiers];
+    return [characters length] > 0 && ([characters characterAtIndex:0] < 0xF700 || [characters characterAtIndex:0] > 0xF8FF);
+}
 
 @implementation SKApplication
 
